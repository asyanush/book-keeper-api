JWT_SECRET_KEY=<jwt_secret_key>
ACCESS_TOKEN_EXPIRE_MINUTES=<access_token_expire_minutes>
REFRESH_TOKEN_EXPIRE_DAYS=<refresh_token_expire_days>
DATABASE_PATH=<database_path>

# OCR engine selection: TESSERACT | VISION | HYBRID
#   - TESSERACT: local Tesseract only (Vision as fallback)
#   - VISION:    Google Cloud Vision primary (Tesseract as fallback)
#   - HYBRID:    Tesseract primary, Vision as fallback
OCR_STRATEGY=HYBRID

# Path to a Google Cloud service-account JSON for the Vision fallback/primary
# engine. Leave empty to disable Vision (Tesseract-only operation).
GOOGLE_APPLICATION_CREDENTIALS=<google_application_credentials>

# Maximum accepted cover-upload size in megabytes.
MAX_UPLOAD_SIZE_MB=10